    "from pathlib import Path\n",
    "import hashlib\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.metrics import brier_score_loss\n",
    "\n",
    "DATA_PATH = Path(\"data/matched_saturdays.csv\")\n",
    "EXPECTED_SHA256 = \"4BA7F83563670174BE36BDB83035CBC1D0067981F65E8201F75F84CCD231F808\"\n",
    "actual_sha256 = hashlib.sha256(DATA_PATH.read_bytes()).hexdigest().upper()\n",
    "assert actual_sha256 == EXPECTED_SHA256, f\"Data hash mismatch: {actual_sha256}\"\n",
    "\n",
    "df = pd.read_csv(DATA_PATH)\n",
    "df[\"saturday\"] = pd.to_datetime(df[\"saturday\"])\n",
    "df[\"observation_date\"] = pd.to_datetime(df[\"observation_date\"])\n",
    "df[\"rain_0_01in\"] = pd.to_numeric(df[\"rain_0_01in\"], errors=\"coerce\")\n",
    "df[\"precipitation_in\"] = pd.to_numeric(df[\"precipitation_in\"], errors=\"coerce\")\n"
   ]
